# Protected runtime defaults. All operational capabilities are off until explicitly enabled.
APP_ENV=development
PRODUCTION_CHANGES_APPROVED=false
OUTBOUND_TEST_MODE=false
ALLOW_REMOTE_NONPROD_DATABASE=false
TEST_EMAIL_ALLOWLIST=
TEST_SMS_ALLOWLIST=

ALLOW_DATABASE_WRITES=false
ALLOW_SCHEDULERS=false
ALLOW_EMAIL_SENDS=false
ALLOW_SMS_SENDS=false
ALLOW_SEEDING=false
ALLOW_ANALYTICS=false
ALLOW_SESSION_REPLAY=false
ALLOW_TWILIO_WEBHOOKS=false
ALLOW_RESEND_WEBHOOKS=false
ALLOW_LEAD_OUTBOX_DISPATCH=false
ALLOW_LEAD_RESEND=false
ALLOW_LEAD_TWILIO=false
# Staff research calls that leave this network: Google Trends and the model
# provider behind blog idea generation, and Overpass behind corporate lead
# discovery. No customer data rides on them, but they were the two paths where
# holding a key was itself the gate. Discovery also egresses on a GET, which
# the write gate cannot see, so this flag is the only control over it.
ALLOW_THIRD_PARTY_RESEARCH=false
# Gates the CRM recording adapter, which writes down what WOULD be sent to
# GymMaster without being able to send it. Read at provider_dispatch.py, not
# declared in runtime_safety.py, which is why it was missing from this file.
# Recording mode is safe to enable; it is the prospect writes below that are not.
ALLOW_LEAD_CRM_RECORDING=false
# GymMaster prospect writes. Off. The adapter refuses to construct without this,
# and still cannot be configured: nobody has read a companyid out of the gym's
# account, and that account currently holds zero members.
ALLOW_GYMMASTER_PROSPECT_WRITES=false
LEAD_OUTBOX_TEST_RECIPIENT_MODE=true
LEAD_OUTBOX_PRODUCTION_DELIVERY_APPROVED=false
LEAD_OUTBOX_EMAIL_ALLOWLIST=
LEAD_OUTBOX_SMS_ALLOWLIST=
LEAD_OUTBOX_BATCH_SIZE=20
LEAD_OUTBOX_LEASE_SECONDS=60
LEAD_PROVIDER_TIMEOUT_SECONDS=8
SCS_PRIMARY_LEAD_OWNER=Teresa
SCS_LEAD_STAFF_EMAIL=
SCS_LEAD_TIMEZONE=America/Los_Angeles
SCS_SMS_QUIET_START_HOUR=20
SCS_SMS_QUIET_END_HOUR=8
PUBLIC_LEAD_RATE_LIMIT=10
PUBLIC_LEAD_RATE_WINDOW_SECONDS=600
PUBLIC_LEAD_MAX_BYTES=32768

MONGO_URL=mongodb://127.0.0.1:27017
# Write acknowledgement. Lead capture answers a visitor with "accepted" on the
# strength of the driver confirming the write, so an unacknowledged connection
# means reporting success for leads that were never stored. w=0 in MONGO_URL is
# rejected at import. This defaults to majority; set it to 1 if the deployment
# is a standalone server rather than a replica set.
MONGO_WRITE_CONCERN=majority
# When APP_ENV is anything other than production and ALLOW_DATABASE_WRITES is
# on, this name must contain one of: test, staging, preview, development, dev,
# local. Otherwise startup raises. The default below satisfies it; a name like
# scs_review does not, and the failure reads as a crash rather than a rule.
DB_NAME=santa_cruz_development
JWT_SECRET=replace-with-a-long-random-development-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
# Mandatory on staging, preview and production: startup raises when it is unset
# there, and it rejects localhost origins in those environments. Fails closed by
# design. Set it to the deployed frontend origin before the first boot.
CORS_ORIGINS=http://127.0.0.1:3000

# The only path to a first admin account. Leave these unset and the backend logs
# "[BOOTSTRAP] No owner exists" on every boot and nobody can sign in to the staff
# CRM at all. Set all three before the first production boot, then rotate the
# password from inside the app.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_OWNER_NAME=Management

# Provider credentials stay blank in local and review environments.
RESEND_API_KEY=
# Separate endpoint signing secret. This is not the Resend API key.
RESEND_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
TWILIO_STATUS_CALLBACK_URL=
# GymMaster is hosted per site at https://<sitename>.gymmasteronline.com, so the
# site name selects which gym is written to. Blank means the adapter refuses.
GYMMASTER_SITE_NAME=
GYMMASTER_API_KEY=
GYMMASTER_COMPANY_ID=
NOTIFICATION_EMAIL=
FROM_EMAIL=
SECURITY_FROM_EMAIL=
CC_EMAIL=
FRONTEND_URL=http://127.0.0.1:3000
UNSUBSCRIBE_SECRET=replace-with-at-least-32-random-characters

# Read by the code, safe to leave at these defaults.
DAILY_EMAIL_LIMIT=50000
SMS_STAFF_NUMBERS=
SCS_LEAD_REPLY_TO=
GYMMASTER_TIMEOUT_SECONDS=10
# Memberships are sold in person by a coach, so there is no online checkout.
# Setting this restores an online purchase path, which is a business decision
# and not a configuration one. Leave it blank unless the owner has asked for it.
MEMBERSHIP_JOIN_URL=
# Powers the staff blog idea generator only, through Emergent's model proxy.
# The package it needs is not on PyPI, so on any other host the feature stays
# off and nothing else is affected.
EMERGENT_LLM_KEY=
