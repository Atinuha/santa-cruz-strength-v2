{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/staff/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/review/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/implementation-preview",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/staff/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/review/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
