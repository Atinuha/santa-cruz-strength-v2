{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/blog/why-surfers-in-santa-cruz-should-lift-weights",
      "destination": "/blog/strength-training-for-surfers-santa-cruz",
      "permanent": true
    },
    {
      "source": "/blog/how-many-days-a-week-should-a-beginner-lift",
      "destination": "/blog/how-many-days-a-week-should-you-lift",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/staff/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/review/:path*",
      "destination": "/app-shell.html"
    },
    {
      "source": "/implementation-preview",
      "destination": "/app-shell.html"
    }
  ],
  "headers": [
    {
      "source": "/staff/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/review/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "cleanUrls": false,
  "trailingSlash": false
}
