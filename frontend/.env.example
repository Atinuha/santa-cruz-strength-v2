# Required for npm run build. Do not include a trailing /api segment.
REACT_APP_BACKEND_URL=https://api.example.com

# Keep false or omit for production. npm run build:preview sets this to true automatically.
REACT_APP_PREVIEW_MODE=false

# Analytics. Unset means analytics never loads, which is the default and matches
# every other outbound capability in this project. Set to true only on the
# production build, and note that consent and the production hostname are still
# both required on top of it. The backend's ALLOW_ANALYTICS never reached the
# browser and so could not control this; that is what this replaces.
REACT_APP_ALLOW_ANALYTICS=false

# Giphy search in the staff email builder. Reaches api.giphy.com from the
# browser. Off unless explicitly enabled, because possessing a key must never
# by itself be sufficient to reach a third party.
REACT_APP_ALLOW_GIPHY=false
REACT_APP_GIPHY_KEY=
